/* ==========================================================================
   ГЛОБАЛЬНЫЕ НАСТРОЙКИ И ОКНА
   ========================================================================== */
QMainWindow, QDialog, AuthWindow {
    background-color: #0e0f14; /* Сделали фоновый цвет чуть глубже и благороднее */
    color: #f1f5f9;            /* Слегка увеличили контраст текста */
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Roboto", sans-serif;
}

/* Вкладки (для окна настроек SettingsDialog) */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.06); /* Тонкая полупрозрачная граница */
    background-color: #151720;
    border-radius: 10px; /* Скругление чуть больше для мягкости */
    top: -1px;
}
QTabBar::tab {
    background-color: transparent; /* Убрали лишние рамки неактивных вкладок */
    color: #64748b;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 8px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background-color: transparent;
    color: #7289da;
    border-bottom: 2px solid #7289da; /* Стильный нижний подчеркивающий индикатор */
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #e2e8f0;
}

/* Элементы интерфейса (Чекбоксы, Статические тексты) */
QCheckBox {
    color: #e2e8f0;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    background-color: #151720;
}
QCheckBox::indicator:checked {
    background-color: #7289da;
    border-color: #7289da;
    image: url(:/icons/checkmark.svg); 
}
QCheckBox::indicator:hover {
    border-color: rgba(114, 137, 218, 0.6);
}

QLabel {
    color: #94a3b8; 
}


/* ==========================================================================
   ПОЛЯ ВВОДА (ПОИСК И ПАРОЛИ)
   ========================================================================== */
QLineEdit {
    background-color: #151720;
    border: 1px solid rgba(255, 255, 255, 0.08); /* Мягкая граница */
    border-radius: 8px;
    padding: 10px 14px; /* Чуть просторнее */
    color: #f8fafc;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1px solid #7289da; /* Четкий акцентный фокус */
    background-color: #1a1c26; /* Легкое осветление фона при вводе */
}
QLineEdit::placeholder {
    color: #475569; /* Приглушенный плейсхолдер */
}


/* ==========================================================================
   СПИСОК ЗАМЕТОК (КАРТОЧКИ)
   ========================================================================== */
QListView {
    background-color: transparent; /* Список сливается с общим глубоким фоном */
    border: none;
    padding: 4px;
    outline: 0;
}

/* Обычное состояние карточки заметки */
QListView::item {
    background-color: #151720; 
    border: 1px solid rgba(255, 255, 255, 0.05); /* Тончайшая дорогая рамка */
    border-radius: 12px; /* Современные скругленные углы */
    padding: 16px 20px;  /* Больше "воздуха" внутри карточки */
    color: #cbd5e1;
    margin-bottom: 10px;
}

/* Наведение на карточку */
QListView::item:hover {
    background-color: #1b1e2a;
    border-color: rgba(255, 255, 255, 0.1); /* Проявляющаяся при наведении рамка */
    color: #f8fafc;
}

/* Выделенная карточка (Активная заметка) */
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:!active {
    background-color: #1d2133 !important; /* Глубокий синеватый оттенок */
    border: 1px solid #7289da !important;  
    color: #ffffff !important;
    font-weight: 600;
}

QListView::item:selected:hover {
    background-color: #22273d !important;
    border-color: #7289da !important;
}


/* ==========================================================================
   КНОПКИ (Улучшенный глянец и глубина)
   ========================================================================== */
/* Дефолтная кнопка */
QPushButton {
    background-color: #151720;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #e2e8f0;
    padding: 10px 18px; /* Увеличили вертикальный кликабельный размер */
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #1d2130;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.15);
}
QPushButton:pressed {
    background-color: #0e0f14;
}

/* Опасное действие — Кнопка удаления */
QMainWindow QPushButton#m_DeleteButton {
    background-color: rgba(239, 68, 68, 0.1); /* Полупрозрачный красный фон */
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #fca5a5;
}
QMainWindow QPushButton#m_DeleteButton:hover {
    background-color: #ef4444; /* Насыщенный красный при наведении */
    color: #ffffff;
    border-color: #ef4444;
}

/* Кнопки-иконки управления (Добавить "+", Настройки) */
/* Кнопки добавления (плюсики для тегов и файлов) */
QPushButton[text*="+"], 
QPushButton#AddTagButton,
QPushButton#AddAttachmentButton, /* Добавил предполагаемое имя кнопки вложений */
QPushButton#m_AddTagButton,      /* На случай префикса m_ */
QPushButton#m_AddAttachmentButton {
    background-color: rgba(114, 137, 218, 0.1); /* Полупрозрачный синий фон */
    border: 1px solid rgba(114, 137, 218, 0.25);
    border-radius: 8px;
    font-weight: bold;
    color: #7289da !important; /* Форсируем красивый синий цвет для плюса */
    font-size: 18px;
    min-width: 34px;  /* Задаем аккуратный размер, чтобы кнопка была квадратной */
    max-width: 34px;
}

QPushButton[text*="+"]:hover, 
QPushButton#AddTagButton:hover,
QPushButton#AddAttachmentButton:hover,
QPushButton#m_AddTagButton:hover,
QPushButton#m_AddAttachmentButton:hover {
    background-color: #7289da;
    color: #ffffff !important; /* При наведении плюс становится белым */
    border-color: #7289da;
}

QPushButton[text*="+"]:pressed, 
QPushButton#AddTagButton:pressed {
    background-color: #5b73c7;
}
/* Теги (Круглые плашки) */
QPushButton#TagButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    color: #94a3b8;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#TagButton:hover {
    background-color: rgba(114, 137, 218, 0.15);
    color: #7289da;
}


/* ==========================================================================
   РЕДАКТОР ЗАМЕТОК
   ========================================================================== */
QTextEdit {
    background-color: #0b0c10; /* Редактор темнее, чтобы сфокусироваться на тексте */
    color: #f1f5f9;
    font-family: "Fira Code", "Consolas", monospace; /* Добавили современный Fira Code */
    font-size: 14px;
    line-height: 1.6;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    padding: 16px;
}
QTextEdit:focus {
    border-color: rgba(114, 137, 218, 0.4); /* Мягкое свечение */
}

/* Панель инструментов */
QToolBar {
    background-color: #0e0f14;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    spacing: 6px;
    padding: 6px;
}
QToolButton {
    background-color: transparent;
    color: #94a3b8;
    border-radius: 6px;
    padding: 6px 10px;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}


/* ==========================================================================
   КНОПКА НАСТРОЕК (ВЕРХНИЙ БАР АВТОРИЗАЦИИ И ГЛАВНОГО ОКНА)
   ========================================================================== */
QPushButton#Settings2FABtn {
    background-color: transparent; /* Сделали её "стеклянной" по умолчанию */
    border: 1px solid transparent;
    border-radius: 8px;
    color: #64748b;
    
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    
    font-size: 16px;
    padding: 0px;
}

QPushButton#Settings2FABtn:hover {
    background-color: rgba(255, 255, 255, 0.05); /* Легкий отклик при наведении */
    color: #f1f5f9;
    border-color: rgba(255, 255, 255, 0.08);
}

QPushButton#Settings2FABtn:pressed {
    background-color: rgba(0, 0, 0, 0.2);
}