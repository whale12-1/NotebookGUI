/* === style.qss === */

/* Главное окно и базовые контейнеры */
QMainWindow, QDialog {
    background-color: #fcfcfc;
    color: #2b2d42;
    font-family: "Segoe UI", sans-serif;
}

/* Строка поиска */
QLineEdit {
    background-color: #f1f3f5;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 8px 12px;
    color: #2b2d42;
}
QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #ced4da;
}

/* Список заметок */
QListView {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 6px;
    outline: 0; /* Отключаем рамку фокуса Windows */
}

/* 1. ОБЫЧНОЕ СОСТОЯНИЕ (Явно пишем !important и состояние !selected) */
QListView::item {
    padding: 12px 16px;
    border-radius: 8px;
    color: #4a4e69;
    margin-bottom: 6px;
    background-color: #f0f2f5; 
    border: 1px solid #e2e5e9;
}

QListView::item:hover {
    background-color: #e8ebea; 
    border-color: #dbdee2;
    color: #2b2d42;
}

/* 2. ВЫДЕЛЕННОЕ СОСТОЯНИЕ (Перебиваем абсолютно все комбинации) */
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:not-active,
QListView::item:selected:!active {
    background-color: #ced4da !important; /* Плотный красивый пастельно-серый цвет при клике */
    border: 1px solid #adb5bd !important;  /* Более темная рамка выделения */
    color: #212529 !important;             /* Темный читаемый текст */
    font-weight: 600;
}

/* Наведение на уже выделенный элемент */
QListView::item:selected:hover {
    background-color: #b0b7bd !important;
    border-color: #8a939b !important;
}

/* 3. КНОПКИ ГЛАВНОГО ОКНА */
QMainWindow QPushButton {
    background-color: #ffffff;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    color: #4a4e69;
    padding: 10px 16px; 
    font-size: 13px;
    font-weight: 600;
}
QMainWindow QPushButton:hover {
    background-color: #f8f9fa;
    color: #2b2d42;
    border-color: #ced4da;
}
QMainWindow QPushButton:pressed {
    background-color: #e9ecef;
}

/* Пастельная кнопка удаления в главном окне */
QMainWindow QPushButton#m_DeleteButton {
    background-color: #fec5bb;
    border: 1px solid #fcd5ce;
    color: #9e5252;
}
QMainWindow QPushButton#m_DeleteButton:hover {
    background-color: #fcd5ce;
}
QPushButton[text="+"] {
    background-color: #f1f3f5;
    border: 1px solid #ced4da;
    border-radius: 6px;
    font-weight: bold;
    color: #495057;
}
QPushButton[text="+"]:hover {
    background-color: #e2e5e9;
}

/* Плашки тегов внутри диалога (с крестиком) */
QPushButton#DialogTagButton {
    background-color: #e8ebea; /* Мягкий пастельный цвет */
    border: 1px solid #d3dad5;
    border-radius: 12px;
    color: #495057;
    padding: 3px 8px;
    font-size: 11px;
}
/* При наведении плашка становится нежно-розовой, намекая на удаление */
QPushButton#DialogTagButton:hover {
    background-color: #fec5bb; 
    border-color: #fcd5ce;
    color: #9e5252;
}
QPushButton#TagButton {
    background-color: #e9ecef;
    border: none;
    border-radius: 14px; /* Делаем их круглыми капсулами */
    color: #495057;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#TagButton:hover {
    background-color: #dee2e6;
    color: #212529;
}
QPushButton#TagButton:pressed {
    background-color: #ced4da;
    /* При нажатии тег будет окрашиваться в цвет выделения */
    background-color: #b0b7bd; 
}
QPushButton#AddTagButton {
    background-color: #f1f3f5;
    border: 1px solid #ced4da;
    border-radius: 6px;
    font-size: 16px;       /* Делаем плюс чуть крупнее */
    font-weight: bold;
    color: #495057;        /* Четкий темно-серый цвет текста */
    padding: 0px;          /* Обнуляем отступы, чтобы текст не выдавливало за границы */
    text-align: center;    /* Центрируем плюс */
}

QPushButton#AddTagButton:hover {
    background-color: #e2e5e9;
    color: #212529;
}

QPushButton#AddTagButton:pressed {
    background-color: #ced4da;
}