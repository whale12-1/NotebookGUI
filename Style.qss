/* ==========================================================================
   ГЛОБАЛЬНЫЕ НАСТРОЙКИ И ОКНА
   ========================================================================== */
QMainWindow, QDialog {
    background-color: #12131a; /* Глубокий темно-серый, почти черный */
    color: #e2e8f0;            /* Мягкий белый текст */
    font-family: "Segoe UI", -apple-system, sans-serif;
}

/* Вкладки (для окна настроек SettingsDialog) */
QTabWidget::pane {
    border: 1px solid #232530;
    background-color: #1a1c24;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    background-color: #12131a;
    color: #94a3b8;
    padding: 8px 16px;
    border: 1px solid #232530;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background-color: #1a1c24;
    color: #7289da;
    border-color: #232530;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background-color: #1e212b;
    color: #e2e8f0;
}

/* Элементы интерфейса (Чекбоксы, Статические тексты) */
QCheckBox {
    color: #e2e8f0;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #4a4f66;
    border-radius: 4px;
    background-color: #1a1c24;
}
QCheckBox::indicator:checked {
    background-color: #7289da;
    border-color: #7289da;
    /* Символ галочки */
    image: url(:/icons/checkmark.svg); /* Если иконок нет, Qt отрисует дефолт поверх фона */
}
QCheckBox::indicator:hover {
    border-color: #7289da;
}

QLabel {
    color: #94a3b8; /* Приглушенный серый для описаний */
}


/* ==========================================================================
   ПОЛЯ ВВОДА (ПОИСК И ПАРОЛИ)
   ========================================================================== */
QLineEdit {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    padding: 8px 14px;
    color: #f1f5f9;
    font-size: 13px;
}
QLineEdit:focus {
    border: 1.5px solid #7289da; /* Неоновая подсветка при работе */
    background-color: #1e212b;
}
QLineEdit::placeholder {
    color: #64748b;
}


/* ==========================================================================
   СПИСОК ЗАМЕТОК (КАРТОЧКИ)
   ========================================================================== */
QListView {
    background-color: #12131a;
    border: none;
    padding: 4px;
    outline: 0;
}

/* Обычное состояние карточки заметки */
QListView::item {
    background-color: #1a1c24; 
    border: 1.5px solid #232530;
    border-radius: 10px;
    padding: 14px 18px;
    color: #cbd5e1;
    margin-bottom: 8px;
}

/* Наведение на карточку */
QListView::item:hover {
    background-color: #1e212b;
    border-color: #3b4252;
    color: #f1f5f9;
}

/* Выделенная карточка (Активная заметка) */
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:!active {
    background-color: #2e3440 !important; /* Контрастный графитовый */
    border: 1.5px solid #7289da !important;  /* Акцентная фиолетовая рамка */
    color: #ffffff !important;
    font-weight: 600;
}

QListView::item:selected:hover {
    background-color: #3b4252 !important;
    border-color: #7289da !important;
}


/* ==========================================================================
   КНОПКИ
   ========================================================================== */
/* Дефолтная кнопка */
QPushButton {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    color: #cbd5e1;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #232530;
    color: #ffffff;
    border-color: #4a4f66;
}
QPushButton:pressed {
    background-color: #12131a;
}

/* Кнопки внутри QMainWindow (Главный экран) */
QMainWindow QPushButton {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
}

/* Опасное действие — Кнопка удаления */
QMainWindow QPushButton#m_DeleteButton {
    background-color: #2a1a1f;
    border: 1.5px solid #4c1d24;
    color: #fca5a5;
}
QMainWindow QPushButton#m_DeleteButton:hover {
    background-color: #4c1d24;
    color: #ffffff;
    border-color: #ef4444;
}

/* Маленькие квадратные кнопки управления (Добавить "+", Настройки, Импорт) */
QPushButton[text="+"], 
QPushButton#AddTagButton {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 6px;
    font-weight: bold;
    color: #7289da;
    font-size: 16px;
    padding: 0px;
}
QPushButton[text="+"]:hover, 
QPushButton#AddTagButton:hover {
    background-color: #7289da;
    color: #ffffff;
    border-color: #7289da;
}

/* Круглые плашки тегов в списке */
QPushButton#TagButton {
    background-color: #232530;
    border: none;
    border-radius: 12px;
    color: #94a3b8;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}
QPushButton#TagButton:hover {
    background-color: #2e3440;
    color: #7289da;
}
QPushButton#TagButton:pressed {
    background-color: #7289da;
    color: #ffffff;
}

/* Теги внутри диалога (с возможностью удаления при наведении) */
QPushButton#DialogTagButton {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 10px;
    color: #cbd5e1;
    padding: 3px 8px;
    font-size: 11px;
}
QPushButton#DialogTagButton:hover {
    background-color: #2a1a1f; 
    border-color: #4c1d24;
    color: #fca5a5;
}


/* ==========================================================================
   РЕДАКТОР ЗАМЕТОК (TEXT EDIT & TOOLBAR)
   ========================================================================== */
QTextEdit {
    background-color: #1a1c24;
    color: #e2e8f0;
    font-family: "Consolas", "Courier New", monospace; /* Кодинг-стайл для заметок */
    font-size: 14px;
    line-height: 1.6;
    border: 1.5px solid #232530;
    border-radius: 8px;
    padding: 12px;
}
QTextEdit:focus {
    border-color: #7289da;
}

/* Панель инструментов */
QToolBar {
    background-color: #12131a;
    border: 1.5px solid #232530;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    spacing: 6px;
    padding: 6px;
}
QToolButton {
    background-color: transparent;
    color: #94a3b8;
    border-radius: 4px;
    padding: 4px 8px;
}
QToolButton:hover {
    background-color: #232530;
    color: #ffffff;
}
QToolButton:pressed {
    background-color: #7289da;
    color: #ffffff;
}


/* ==========================================================================
   ОКНО ПРОСМОТРА РАСШИФРОВАННОЙ ЗАМЕТКИ (DECRYPT DIALOG)
   ========================================================================== */
QDialog#DecryptViewDialog {
    background-color: #12131a;
}
QTextEdit#DecryptViewer {
    background-color: #1a1c24;
    color: #f1f5f9;
    border: 1.5px solid #232530;
    border-radius: 10px;
    padding: 14px;
    font-size: 14px;
}
QPushButton#DecryptCloseBtn {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    padding: 8px 18px;
    color: #94a3b8;
    font-weight: bold;
}
QPushButton#DecryptCloseBtn:hover {
    background-color: #232530;
    color: #ffffff;
    border-color: #4a4f66;
}


/* ==========================================================================
   ОКНО 2FA И СИСТЕМНЫЕ КНОПКИ
   ========================================================================== */
QDialog#TwoFactorAuthDialog {
    background-color: #12131a;
}
QPushButton#2FAConfirmBtn {
    background-color: #10b981; /* Элегантный изумрудно-зеленый вместо кислотного */
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: bold;
}
QPushButton#2FAConfirmBtn:hover {
    background-color: #059669;
}

QPushButton#2FACancelBtn {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    padding: 8px 18px;
    color: #cbd5e1;
}
QPushButton#2FACancelBtn:hover {
    background-color: #232530;
    border-color: #4a4f66;
    color: #ffffff;
}

/* Кнопки-иконки в интерфейсе (Шестеренки, бэкапы) */

QPushButton#btnImportBackup {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    color: #94a3b8;
    
    /* Жестко задаем размеры, чтобы layout не растягивал её на пол-экрана */
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    
    padding: 0px;
}

QPushButton#btnImportBackup:hover {
    background-color: #232530;
    color: #7289da;
    border-color: #7289da;
}

QPushButton#btnImportBackup:pressed {
    background-color: #12131a;
}

/* Убираем стрелочку меню (индикатор), если кнопка использует QMenu */
QPushButton#btnImportBackup::menu-indicator {
    image: none;
    width: 0px;
    subcontrol-position: right center;
}

QPushButton#Settings2FABtn {
    background-color: #1a1c24;
    border: 1.5px solid #232530;
    border-radius: 8px;
    color: #94a3b8;
    
    /* Точные размеры квадратной кнопки */
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    
    font-size: 18px; /* Оптимальный размер для символа ⚙ */
    padding: 0px;
    text-align: center;
}

QPushButton#Settings2FABtn:hover {
    background-color: #232530;
    color: #7289da;
    border-color: #7289da;
}

QPushButton#Settings2FABtn:pressed {
    background-color: #12131a;
}