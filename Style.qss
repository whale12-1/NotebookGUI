/* ==========================================================================
   ГЛОБАЛЬНЫЕ НАСТРОЙКИ ОКРЫТЫХ ОКОН И КАНВАСА
   ========================================================================== */

/* Полностью убираем любые жесткие фоны у корневых окон, чтобы работал Mica */
QMainWindow, 
QDialog, 
QWidget#AuthWindowInstance, 
QWidget#MainWindowInstance,
#AuthWindowInstance, 
#MainWindowInstance {
    background-color: transparent !important;
    background: transparent !important;
    color: #f1f5f9;            
    font-family: "Segoe UI", -apple-system, sans-serif;
}

/* Наша единая подложка-карточка (Canvas) 
   Легкий белый глянец отлично пропускает и подчеркивает текстуру Mica под ней */
QWidget#MainCanvas {
    background-color: rgba(255, 255, 255, 0.03); 
    border: 1px solid rgba(255, 255, 255, 0.08); 
    border-radius: 12px;
}


/* ==========================================================================
   ПОЛЯ ВВОДА (ПОИСК И ПАРОЛИ)
   ========================================================================== */
QLineEdit {
    background-color: rgba(20, 21, 28, 0.6); /* Полупрозрачный темный фон */
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px 14px;
    color: #f8fafc;
    font-size: 13px;
}
QLineEdit:focus {
    background-color: rgba(20, 21, 28, 0.85); /* Чуть плотнее при фокусе, чтобы текст читался идеально */
    border: 1.5px solid #7289da; /* Фирменный акцентный фокус */
}
QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.35); /* Неконтрастный читаемый плейсхолдер */
}


/* ==========================================================================
   ОБЩИЕ КНОПКИ (Глянцевый Mica-стиль)
   ========================================================================== */
QPushButton {
    background-color: rgba(255, 255, 255, 0.06); /* Мягкое стекло */
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    color: #f1f5f9;
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.12); /* Приближение при наведении */
    border-color: rgba(255, 255, 255, 0.15);
    color: #ffffff;
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.04); /* Проседание при клике */
}

/* ЗАМЫЛЕННОЕ / ЗАБЛОКИРОВАННОЕ СОСТОЯНИЕ (как на твоем скриншоте) */
QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.01) !important;
    border-color: rgba(255, 255, 255, 0.02) !important;
    color: rgba(255, 255, 255, 0.2) !important;
}

/* Опасное действие — Кнопка удаления */
QMainWindow QPushButton#m_DeleteButton {
    background-color: rgba(239, 68, 68, 0.15); /* Полупрозрачный красный */
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #fca5a5;
}
QMainWindow QPushButton#m_DeleteButton:hover {
    background-color: rgba(239, 68, 68, 0.8); /* Яркий красный при наведении */
    border-color: rgba(239, 68, 68, 0.8);
    color: #ffffff;
}
QMainWindow QPushButton#m_DeleteButton:disabled {
    background-color: rgba(239, 68, 68, 0.03) !important;
    border-color: rgba(239, 68, 68, 0.05) !important;
    color: rgba(239, 68, 68, 0.2) !important;
}


/* ==========================================================================
   КНОПКА НАСТРОЕК (Шестерёнка авторизации и верхний бар)
   ========================================================================== */
QPushButton#Settings2FABtn,
QPushButton#AuthSettingsButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.6);
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 16px;
    padding: 0px;
}

QPushButton#Settings2FABtn:hover,
QPushButton#AuthSettingsButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QPushButton#Settings2FABtn:pressed,
QPushButton#AuthSettingsButton:pressed {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Скрываем уродливую уплывшую стрелку меню у шестерёнки */
QPushButton#AuthSettingsButton::menu-indicator,
QPushButton#Settings2FABtn::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
    visible: none;
}


/* ==========================================================================
   ВЫПАДАЮЩИЕ СИСТЕМНЫЕ МЕНЮ (QMenu)
   ========================================================================== */
QMenu {
    background-color: rgba(25, 26, 32, 0.96); /* Плотное темное стекло */
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 6px 28px 6px 16px;
    color: #cbd5e1;
    background-color: transparent;
}
QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin: 4px 0px;
}


/* ==========================================================================
   СПИСОК ЗАМЕТОК И КАРТОЧКИ (QListView)
   ========================================================================== */
QListView {
    background-color: rgba(0, 0, 0, 0.2); /* Темная подложка, чтобы выделить список */
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 6px;
    outline: 0;
}

/* Карточка заметки в обычном состоянии */
QListView::item {
    background-color: rgba(255, 255, 255, 0.03); /* Мягкие стеклянные карточки */
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 10px;
    padding: 14px 18px;
    color: #cbd5e1;
    margin-bottom: 8px;
}

QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.08);
    color: #f8fafc;
}

/* Выбранная карточка (Активная заметка) */
QListView::item:selected,
QListView::item:selected:active,
QListView::item:selected:!active {
    background-color: rgba(114, 137, 218, 0.15) !important; /* Легкий акцентный синеватый тон */
    border: 1.5px solid #7289da !important;  
    color: #ffffff !important;
    font-weight: 600;
}

QListView::item:selected:hover {
    background-color: rgba(114, 137, 218, 0.2) !important;
}


/* ==========================================================================
   ВКЛАДКИ (Табы в настройках SettingsDialog)
   ========================================================================== */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.06);
    background-color: rgba(20, 21, 28, 0.4); /* Полупрозрачная панель вкладок */
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #64748b;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 6px;
    font-weight: 500;
}
QTabBar::tab:selected {
    color: #7289da;
    border-bottom: 2px solid #7289da; /* Элегантное подчеркивание активного таба */
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #e2e8f0;
}


/* ==========================================================================
   ТЕГИ И ДВУХФАКТОРНЫЕ КНОПКИ "+"
   ========================================================================== */
/* Кнопки-теги */
QPushButton#TagButton {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    color: #94a3b8;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#TagButton:hover {
    background-color: rgba(114, 137, 218, 0.15);
    color: #7289da;
}

/* Кнопки добавления (плюсики) */
QPushButton[text*="+"], 
QPushButton#AddTagButton,
QPushButton#AddAttachmentButton,
QPushButton#m_AddTagButton,
QPushButton#m_AddAttachmentButton {
    background-color: rgba(114, 137, 218, 0.12);
    border: 1px solid rgba(114, 137, 218, 0.25);
    border-radius: 8px;
    color: #7289da !important;
    font-size: 18px;
    min-width: 34px;
    max-width: 34px;
}
QPushButton[text*="+"]:hover, 
QPushButton#AddTagButton:hover,
QPushButton#AddAttachmentButton:hover {
    background-color: #7289da;
    color: #ffffff !important;
}


/* ==========================================================================
   ТЕКСТОВЫЕ ЭЛЕМЕНТЫ И РЕДАКТОРЫ (QTextEdit)
QTextEdit {
    background-color: rgba(20, 21, 28, 0.4) !important; /* Наше красивое стекло */
    color: #f1f5f9;
    font-family: "Fira Code", "Consolas", monospace;
    font-size: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 16px;
}

/* Полностью очищаем фон и любые рамки внутреннего контейнера */
QTextEdit QWidget {
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
}

QTextEdit:focus {
    background-color: rgba(20, 21, 28, 0.6) !important;
    border-color: #7289da;
}

/* Убеждаемся, что при фокусе внутренний виджет тоже остается прозрачным */
QTextEdit:focus QWidget {
    background: transparent !important;
    background-color: transparent !important;
}
QLabel {
    color: #94a3b8; 
}

QCheckBox {
    color: #e2e8f0;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    background-color: rgba(20, 21, 28, 0.6);
}
QCheckBox::indicator:checked {
    background-color: #7289da;
    border-color: #7289da;
}

QDialog#CreateNoteDialog QFrame[frameShape="4"] { /* 4 — это внутреннее значение QFrame::HLine в Qt */
    background-color: rgba(255, 255, 255, 0.08) !important;
    min-height: 1px;
    max-height: 1px;
    border: none;
}

QPushButton#BrowseAttachmentButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #e2e8f0;
    font-size: 13px;
    padding: 0px 16px; /* Переопределяем огромные отступы */
}

QPushButton#BrowseAttachmentButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Исправляем читаемость плейсхолдера у заблокированного поля */
QLineEdit:disabled {
    background-color: rgba(20, 21, 28, 0.3) !important;
    border-color: rgba(255, 255, 255, 0.02) !important;
    color: rgba(255, 255, 255, 0.25) !important;
}